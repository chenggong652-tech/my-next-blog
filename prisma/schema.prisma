generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Todo {
  id        String   @id @default(cuid())
  content   String
  finished  Boolean  @default(false)
  sortOrder Int      @default(0) // 新增：排序数字，数字越小越排在上面
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Message {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes MessageLike[]
  replies Reply[]
}


model Blog {
  id        String   @id @default(cuid())
  title     String   // 文章标题
  content   String   // 文章正文
  views     Int      @default(0) // 阅读量，默认为0
  category  String   @default("未分类") // 文章分类，默认"未分类"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  blogs         Blog[]
  messages      Message[]
  todos         Todo[]
  messageLikes MessageLike[]
  replies Reply[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}
// 留言点赞中间表：记录谁给哪条留言点赞
model MessageLike {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId]) // 联合唯一约束：同一个用户对同一条留言只能有一条记录，防止重复点赞
}

// 留言回复表：一条留言可以有多条回复
model Reply {
  id        String   @id @default(cuid())
  content   String   // 回复内容
  createdAt DateTime @default(now())
  messageId String   // 这条回复属于哪条留言
  userId    String   // 谁回复的

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
