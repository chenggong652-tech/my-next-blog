generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Todo {
  id        String   @id @default(cuid())
  content   String
  finished  Boolean  @default(false)
  sortOrder Int      @default(0) // 新增：排序数字，数字越小越排在上面
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Message {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes MessageLike[]
  replies Reply[]
}


model Blog {
  id        String   @id @default(cuid())
  title     String   // 文章标题
  content   String   // 文章正文
  views     Int      @default(0) // 阅读量，默认为0
  category  String   @default("未分类") // 文章分类，默认"未分类"
  pinned    Boolean  @default(false) // 是否置顶：true=置顶
  coverImage String? // 封面图片地址（可空：不填就不显示封面）
  status    String   @default("published") // 文章状态：published=已发布，draft=草稿
  series    String? // 所属系列/专栏名（可空：不属于任何系列）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags BlogTag[] // 这篇文章挂了哪些标签（多对多）
  favorites Favorite[] // 这篇文章被哪些用户收藏了（多对多）
    comments Comment[] // 这篇文章的评论（一对多）
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  blogs         Blog[]
  messages      Message[]
  todos         Todo[]
  messageLikes MessageLike[]
  replies Reply[]
  favorites Favorite[] // 这个用户收藏了哪些文章
  comments Comment[] // 这个用户发表的评论
  commentLikes CommentLike[] // 这个用户给哪些评论点过赞
  commentReplies CommentReply[] // 这个用户发的评论回复
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}
// 留言点赞中间表：记录谁给哪条留言点赞
model MessageLike {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId]) // 联合唯一约束：同一个用户对同一条留言只能有一条记录，防止重复点赞
}

// 留言回复表：一条留言可以有多条回复
model Reply {
  id        String   @id @default(cuid())
  content   String   // 回复内容
  createdAt DateTime @default(now())
  messageId String   // 这条回复属于哪条留言
  userId    String   // 谁回复的

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// 标签表：一个标签可以挂多篇文章
model Tag {
  id    String   @id @default(cuid())
  name  String   @unique // 标签名（唯一，不重复）
  blogs BlogTag[]
}

// 中间表：记录"哪篇文章挂了哪些标签"（多对多的桥梁）
model BlogTag {
  blogId String
  tagId  String
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId]) // 联合主键：同一对(文章,标签)只能出现一次
}
// 收藏表：记录"哪个用户收藏了哪篇文章"
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  blogId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId]) // 联合唯一：同一用户对同一文章只能收藏一次
}
// 评论表：一条评论属于一篇文章 + 一个用户
model Comment {
  id        String   @id @default(cuid())
  content   String   // 评论内容
  createdAt DateTime @default(now())
  userId    String   // 谁评论的
  blogId    String   // 评论哪篇文章

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  likes CommentLike[] // 这条评论收到的点赞
  replies CommentReply[] // 这条评论收到的回复
}

// 评论点赞表：记录"哪个用户给哪条评论点过赞"（和收藏表一个套路）
model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId]) // 联合唯一：同一用户对同一条评论只能赞一次
}

// 评论回复表：一条评论可以有多条回复
model CommentReply {
  id        String   @id @default(cuid())
  commentId String
  content   String
  createdAt DateTime @default(now())
  userId    String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// 访问记录表：每次打开网站记一行（按天统计全站访问量）
model Visit {
  id        String   @id @default(cuid())
  date      String   // 访问日期：2026-10-18（北京时间）
  createdAt DateTime @default(now())
}

// 音乐馆歌曲表（M7 专线）：一首歌的所有信息
model Song {
  id         String   @id @default(cuid())
  title      String   // 歌名
  genre      String   @default("未分类") // 风格：电子/流行/古风/R&B
  cover      String?  // 封面路径（/music/covers/snow-tower.webp）
  audioUrl   String   // 音频路径（/music/snow-tower.mp3）
  lyrics     String?  @db.Text // 完整歌词（每行一句，歌词滚动时用）
  isOriginal Boolean  @default(true) // true=AI原创可商用 / false=翻唱仅学习
  status     String   @default("published") // published=上线 / hidden=隐藏
  sortOrder  Int      @default(0) // 排序：数字小排前面
  plays      Int      @default(0) // 播放次数：每次播放 +1（热歌榜用）
  likes      SongLike[] // 反向关系：这首歌被谁收藏过
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 歌曲收藏表（M7 专线）：谁收藏了哪首歌
model SongLike {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  createdAt DateTime @default(now())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade) // 歌被删 → 收藏记录一起删

  @@unique([songId, userId]) // 同一人同一首歌只能收藏一次（防重复点❤️）
}

// 第 22 课：后台操作日志（谁删了文章/评论都能查）
model OperationLog {
  id        String   @id @default(cuid())
  action    String   // 操作名：删除文章 / 删除评论 / 删除留言...
  target    String   // 被操作的对象：文章标题 / 评论内容（截断）
  userName  String   // 谁操作的（直接存名字，展示不用查库）
  createdAt DateTime @default(now())
}



