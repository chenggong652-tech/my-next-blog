generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Todo {
  id        String   @id @default(cuid())
  content   String
  finished  Boolean  @default(false)
  sortOrder Int      @default(0) // 新增：排序数字，数字越小越排在上面
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
}

model Blog {
  id        String   @id @default(cuid())
  title     String   // 文章标题
  content   String   // 文章正文
  createdAt DateTime @default(now())
}


