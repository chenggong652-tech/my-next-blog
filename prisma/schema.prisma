generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Todo {
  id        String   @id @default(cuid())
  content   String
  finished  Boolean  @default(false)
  sortOrder Int      @default(0) // 新增：排序数字，数字越小越排在上面
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Message {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes MessageLike[]
  replies Reply[]
  // 第 E4 课：索引
  @@index([createdAt]) // 留言板按时间倒序排（最新在前）
  @@index([userId])    // 查"我的留言"
}


model Blog {
  id        String   @id @default(cuid())
  title     String   // 文章标题
  content   String   // 文章正文
  views     Int      @default(0) // 阅读量，默认为0
  category  String   @default("未分类") // 文章分类，默认"未分类"
  pinned    Boolean  @default(false) // 是否置顶：true=置顶
  coverImage String? // 封面图片地址（可空：不填就不显示封面）
  status    String   @default("published") // 文章状态：published=已发布，draft=草稿
  series    String? // 所属系列/专栏名（可空：不属于任何系列）
  seoTitle       String? // 🅰️ A2：SEO 标题（搜索引擎显示的加长版标题）
  seoDescription String? // 🅰️ A2：SEO 简介（搜索结果里的一句话）
  keywords       String? // 🅰️ A2：关键词（逗号分隔，告诉搜索引擎这篇给谁看）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags BlogTag[] // 这篇文章挂了哪些标签（多对多）
  favorites Favorite[] // 这篇文章被哪些用户收藏了（多对多）
    comments Comment[] // 这篇文章的评论（一对多）
  versions ArticleVersion[] // 历史版本（第D4课：每次保存留快照）
  // 第 E4 课：索引（目录页）——网站经常按这些条件找文章
  @@index([category]) // 按分类找文章（如"AI教程"）
  @@index([series])   // 按系列专栏找文章
  @@index([status])   // 按"已发布/草稿"找
  @@index([userId])   // 找"我写的文章"
}

// 第 D4 课：文章历史版本（每次保存留快照，改坏了能回滚）
model ArticleVersion {
  id        String   @id @default(cuid())
  blogId    String
  title     String   // 当时保存的标题
  content   String   @db.Text // 当时保存的正文
  createdAt DateTime @default(now()) // 什么时候存的

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  // 第 E4 课：索引
  @@index([blogId]) // 查某篇文章的历史版本（D4 页面每次都在用）
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  balance       Int       @default(0) // 余额（分）：1元=100（第31课）
    level       Int       @default(1) // 会员等级 1~5（第33课）：消费越多升越高
  totalSpent  Int       @default(0) // 累计消费（分）：升级看的"经验值"
  refCode      String?    @unique // 🅲2 推广码：别人点带这个码的链接进来，你赚佣金
  commission   Int        @default(0) // 🅲2 佣金余额（分）：推广成交自动累积（可当钱用/提现）
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  failCount     Int       @default(0) // 第 X3 课：登录失败次数（防爆破）
  lockUntil     DateTime? // 第 X3 课：锁定到几点几分（null=没被锁）
  accounts      Account[]
  sessions      Session[]
  blogs         Blog[]
  messages      Message[]
  todos         Todo[]
  messageLikes MessageLike[]
  replies Reply[]
  favorites Favorite[] // 这个用户收藏了哪些文章
  comments Comment[] // 这个用户发表的评论
  commentLikes CommentLike[] // 这个用户给哪些评论点过赞
  commentReplies CommentReply[] // 这个用户发的评论回复
  purchases Purchase[] // 这个用户买过哪些资源（第31课）
  orders Order[] @relation("BuyerOrders") // 这个用户买过哪些订单（第32课）
  commissions Commission[] // 🅲2 我推广赚到的佣金记录
  refOrders Order[] @relation("ReferralOrders") // 🅲2 我推广带来的订单（别人买，记我头上）
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}
// 留言点赞中间表：记录谁给哪条留言点赞
model MessageLike {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId]) // 联合唯一约束：同一个用户对同一条留言只能有一条记录，防止重复点赞
}

// 留言回复表：一条留言可以有多条回复
model Reply {
  id        String   @id @default(cuid())
  content   String   // 回复内容
  createdAt DateTime @default(now())
  messageId String   // 这条回复属于哪条留言
  userId    String   // 谁回复的

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// 标签表：一个标签可以挂多篇文章
model Tag {
  id    String   @id @default(cuid())
  name  String   @unique // 标签名（唯一，不重复）
  blogs BlogTag[]
}

// 中间表：记录"哪篇文章挂了哪些标签"（多对多的桥梁）
model BlogTag {
  blogId String
  tagId  String
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId]) // 联合主键：同一对(文章,标签)只能出现一次
}
// 收藏表：记录"哪个用户收藏了哪篇文章"
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  blogId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId]) // 联合唯一：同一用户对同一文章只能收藏一次
}
// 评论表：一条评论属于一篇文章 + 一个用户
model Comment {
  id        String   @id @default(cuid())
  content   String   // 评论内容
  createdAt DateTime @default(now())
  userId    String   // 谁评论的
  blogId    String   // 评论哪篇文章

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  likes CommentLike[] // 这条评论收到的点赞
  replies CommentReply[] // 这条评论收到的回复
  // 第 E4 课：索引
  @@index([blogId]) // 查某篇文章下的评论（最常用的查询）
  @@index([userId]) // 查"我发过的评论"
}

// 评论点赞表：记录"哪个用户给哪条评论点过赞"（和收藏表一个套路）
model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId]) // 联合唯一：同一用户对同一条评论只能赞一次
}

// 评论回复表：一条评论可以有多条回复
model CommentReply {
  id        String   @id @default(cuid())
  commentId String
  content   String
  createdAt DateTime @default(now())
  userId    String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// 访问记录表：每次打开网站记一行（按天统计全站访问量）
model Visit {
  id        String   @id @default(cuid())
  date      String   // 访问日期：2026-10-18（北京时间）
  createdAt DateTime @default(now())
}

// 音乐馆歌曲表（M7 专线）：一首歌的所有信息
model Song {
  id         String   @id @default(cuid())
  title      String   // 歌名
  genre      String   @default("未分类") // 风格：电子/流行/古风/R&B
  cover      String?  // 封面路径（/music/covers/snow-tower.webp）
  audioUrl   String   // 音频路径（/music/snow-tower.mp3）
  lyrics     String?  @db.Text // 完整歌词（每行一句，歌词滚动时用）
  isOriginal Boolean  @default(true) // true=AI原创可商用 / false=翻唱仅学习
  status     String   @default("published") // published=上线 / hidden=隐藏
  sortOrder  Int      @default(0) // 排序：数字小排前面
  plays      Int      @default(0) // 播放次数：每次播放 +1（热歌榜用）
  likes      SongLike[] // 反向关系：这首歌被谁收藏过
  createdAt  DateTime @default(now())
  // 第 E4 课：索引
  @@index([genre]) // 按风格筛选歌（流行/古风/R&B）
  @@index([status]) // 按上架/隐藏找
  @@index([plays])  // 热歌榜按播放量排序
  updatedAt  DateTime @updatedAt
}

// 歌曲收藏表（M7 专线）：谁收藏了哪首歌
model SongLike {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  createdAt DateTime @default(now())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade) // 歌被删 → 收藏记录一起删

  @@unique([songId, userId]) // 同一人同一首歌只能收藏一次（防重复点❤️）
}

// 第 22 课：后台操作日志（谁删了文章/评论都能查）
model OperationLog {
  id        String   @id @default(cuid())
  action    String   // 操作名：删除文章 / 删除评论 / 删除留言...
  target    String   // 被操作的对象：文章标题 / 评论内容（截断）
  userName  String   // 谁操作的（直接存名字，展示不用查库）
  createdAt DateTime @default(now())
}

// 第 D3 课：敏感词库（后台可增删，留言/评论实时用）
model BadWord {
  id        String   @id @default(cuid())
  word      String   @unique // 词不能重复（防止加两遍）
  createdAt DateTime @default(now())
}

// 第 30 课：资源上架系统（商业站"货架"）
model Resource {
  id          String   @id @default(cuid())
  title       String   // 资源名称：如"ChatGPT 提示词大全"
  category    String   @default("AI 教程") // 分类：AI 教程 / 提示词 / 工具 / 模板
  cover       String?  // 封面图（可空）
  description String   @db.Text // 简介：这个资源是啥、值在哪
  price       Int      @default(0) // 价格（分）：0=免费，990=9.9元
  discountPrice Int?     // 🅲1 限时折扣价（分）：填了=有活动，空=按原价卖
  discountEndAt DateTime? // 🅲1 折扣截止时间：过了这个点自动恢复原价
  downloadUrl String?  // 下载链接（付费/免费资源的网盘或直链）
  purchases Purchase[] // 谁买过这个资源（第31课）
  orders Order[] // 这个资源被下过哪些订单（第32课）
  status      String   @default("published") // published=上架 / hidden=下架
  sortOrder   Int      @default(0) // 排序：数字小排前面
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 第 31 课：付费下载 - 购买记录表（谁买了哪个资源，防重复买 + 已购列表）
model Purchase {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  amount     Int      // 成交价（分）
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId]) // 同一资源同一人只能买一次
}

// 第 32 课：支付接入 - 订单表（下单先记"待支付"，支付成功才"已支付"，绝不一单两付）
model Order {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  amount     Int      // 订单金额（分）
  status     String   @default("pending") // pending=待支付 / paid=已支付 / cancelled=已取消
  method     String   @default("balance") // balance=余额支付 / wechat=模拟微信 / alipay=模拟支付宝
  refUserId  String?  // 🅲2 这笔订单是谁推广带来的（null=自然成交，没有推广员）
  createdAt  DateTime @default(now())
  paidAt     DateTime? // 什么时候付的款（空=还没付）
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Cascade)
  referrer   User?    @relation("ReferralOrders", fields: [refUserId], references: [id]) // 🅲2 推广员
}

// 🅲2 佣金记录表：谁通过我的推广链接买了啥，我赚了多少（推广中心明细用）
model Commission {
  id            String   @id @default(cuid())
  userId        String   // 推广员（谁赚了这笔钱）
  orderId       String   // 关联哪笔订单
  buyerName     String   // 买家昵称（展示用，不用再查库）
  resourceTitle String   // 买的是什么资源（展示用）
  amount        Int      // 这笔佣金（分）：订单实付 × 20%
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId]) // 推广中心按推广员查佣金记录
}





